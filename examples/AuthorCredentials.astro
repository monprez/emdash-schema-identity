---
/**
 * Example: show the people credited on a post, with the job title, expertise
 * and credentials that Schema Identity publishes for them.
 *
 * Structured data should describe what readers can see, so a theme that
 * publishes credentials in markup should also show them. This component asks
 * the plugin's public `people` route, in-process through the EmDash runtime
 * (no HTTP request), for exactly what the markup contains today: expired,
 * hidden and not-yet-issued credentials are already left out.
 *
 * Every credit is shown under its own label: an unlabelled credit is an
 * author, and a labelled one ("Reviewed by", "Photos") says so, so a reviewer
 * is never presented as an author.
 *
 * Copy it into your theme and style it to match. Usage:
 *   <AuthorCredentials bylines={post.data.bylines ?? []} />
 */

interface Credit {
	byline: { displayName: string; bio: string | null; websiteUrl: string | null; translationGroup: string | null };
	roleLabel?: string | null;
}

interface PublicPerson {
	jobTitle?: string;
	knowsAbout: string[];
	credentials: Array<{ name: string; issuer?: string; dateIssued?: string; dateExpires?: string; url?: string }>;
}

const { bylines = [] } = Astro.props as { bylines?: Credit[] };
const emdash = Astro.locals.emdash;

async function lookup(group: string): Promise<PublicPerson | null> {
	if (!emdash?.handlePublicPluginApiRoute) return null;
	const url = new URL(`/_emdash/api/plugins/schema-identity/people?group=${encodeURIComponent(group)}`, Astro.url);
	const result = await emdash.handlePublicPluginApiRoute("schema-identity", "GET", "/people", new Request(url));
	const data = result.success ? (result.data as PublicPerson | { error: string }) : null;
	return data && !("error" in data) ? data : null;
}

const people = (
	await Promise.all(
		bylines
			.filter((c) => c.byline.translationGroup)
			.map(async (c) => ({ credit: c, person: await lookup(c.byline.translationGroup!) })),
	)
).filter(({ person }) => person && (person.jobTitle || person.credentials.length > 0 || person.knowsAbout.length > 0));

const year = (ymd?: string) => ymd?.slice(0, 4);
const roleOf = (c: Credit) => c.roleLabel?.trim() ?? "";
const heading = people.every(({ credit }) => roleOf(credit) === "")
	? people.length === 1
		? "About the author"
		: "About the authors"
	: "About the people behind this article";
---

{
	people.length > 0 && (
		<section class="author-credentials" aria-labelledby="author-credentials-title">
			<h2 id="author-credentials-title">{heading}</h2>
			{people.map(({ credit, person }) => (
				<div class="person">
					<p class="name">
						{roleOf(credit) && <span class="role">{roleOf(credit)}: </span>}
						{credit.byline.displayName}
						{person!.jobTitle && <span class="job">, {person!.jobTitle}</span>}
					</p>
					{credit.byline.bio && <p class="bio">{credit.byline.bio}</p>}
					{person!.credentials.length > 0 && (
						<ul class="credentials">
							{person!.credentials.map((c) => (
								<li>
									{c.url ? <a href={c.url} rel="noopener">{c.name}</a> : c.name}
									{c.issuer && <span>, {c.issuer}</span>}
									{c.dateIssued && <span class="since"> (since {year(c.dateIssued)})</span>}
								</li>
							))}
						</ul>
					)}
					{person!.knowsAbout.length > 0 && <p class="topics">Expertise: {person!.knowsAbout.join(", ")}</p>}
				</div>
			))}
		</section>
	)
}

<style>
	.author-credentials {
		margin-block: 3rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg-subtle);
	}
	h2 {
		margin: 0 0 1rem;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-text-secondary);
	}
	.person + .person {
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border-subtle);
	}
	.name {
		margin: 0;
		font-weight: 600;
	}
	.role,
	.job,
	.since,
	.topics {
		font-weight: 400;
		color: var(--color-text-secondary);
	}
	.bio,
	.topics {
		margin: 0.35rem 0 0;
	}
	.credentials {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
	}
	a {
		color: var(--color-brand);
	}
</style>
