{
	"name": "schema-identity",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.2.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.2.0",
		"@emdash-cms/plugin-cli": "0.13.3",
		"@emdash-cms/plugin-test": "0.2.8",
		"emdash": "1.2.0",
		"typescript": "^5.9.0",
		"vite": "^8.0.0",
		"vitest": "^4.1.0"
	},
	"description": "Structured data for EmDash: a connected schema.org graph for your site, the people behind your content and their credentials.",
	"packageManager": "pnpm@12.8.1"
}
